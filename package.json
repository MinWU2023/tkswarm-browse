{
  "name": "tkswarm-browses",
  "version": "1.0.23",
  "description": "第一页自研浏览器 — Bit Browser API compatible local server",
  "main": "electron/main.js",
  "author": "TkSwarm",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "server": "node src/standalone-server.js",
    "postinstall": "node scripts/ensure-chromium.js || exit 0",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:win:portable": "electron-builder --win portable --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "smoke": "node scripts/smoke-test.js",
    "smoke:lifecycle": "node scripts/smoke-lifecycle.js",
    "smoke:upsert": "node scripts/smoke-upsert.js",
    "smoke:all": "node scripts/smoke-test.js && node scripts/smoke-lifecycle.js && node scripts/smoke-upsert.js",
    "verify:packaged": "node scripts/verify-packaged-proxy.js",
    "icons": "node scripts/generate-icons.js",
    "predist": "npm run icons",
    "predist:win": "npm run icons",
    "predist:win:portable": "npm run icons",
    "predist:mac": "npm run icons"
  },
  "dependencies": {
    "express": "^4.22.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.50.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.tkswarm.browses",
    "productName": "第一页自研浏览器",
    "executableName": "TkSwarmBrowser",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "compression": "normal",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "files": [
      "electron/**/*",
      "src/**/*",
      "ui/**/*",
      "scripts/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icons/icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icons/icon.png"
      }
    ],
    "icon": "build/icon.png",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TkSwarmBrowser-${version}-win-${arch}-setup.${ext}",
      "executableName": "TkSwarmBrowser"
    },
    "portable": {
      "artifactName": "TkSwarmBrowser-${version}-win-portable.${ext}",
      "unpackDirName": "TkSwarmBrowser-${version}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "第一页自研浏览器"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "TkSwarmBrowser-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "TkSwarmBrowser-${version}-mac-${arch}.${ext}"
    }
  }
}
