# TkSwarm PHP API（桌面端登录用）
TKSWARM_API_BASE=http://127.0.0.1:8080/api

# 本地 Bit 兼容 API
TKSWARM_BROWSER_HOST=127.0.0.1
TKSWARM_BROWSER_PORT=54345

# 每账号最大环境数
TKSWARM_BROWSER_MAX_ENVS=300

# 同时运行的 Chrome 窗口上限（0=不限制；默认 20，防内存打爆）
TKSWARM_BROWSER_MAX_CONCURRENT=20

# 可选：自定义 Chrome 路径
# TKSWARM_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
